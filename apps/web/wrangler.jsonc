{
  // Cloudflare Workers — Worker script + Static Assets. The Worker (worker/index.ts)
  // injects share-link OG (course name / plan size) via HTMLRewriter; all other
  // requests pass through to the ./out static export (Next `output: export`).
  // Deploy: npm run build && wrangler deploy   (Dashboard "Workers Builds" runs the same).
  // Custom domain (course.ntutbox.com) is added in the dashboard.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ntutbox-course-web",
  "compatibility_date": "2025-06-05",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // 實體路由＝"/"（分享連結都是 query string）＋ /guide/*（靜態內容頁）；未知路徑回
    // out/404.html + 404 狀態碼，避免整站被搜尋引擎當 soft-404。
    //（曾為 SPA fallback；本站沒有 path-based client route。）
    "not_found_handling": "404-page",
    // 只讓根文件（分享連結 path 為 "/"）與動態課程 sitemap 先進 worker；
    // 其餘靜態資源直接由 assets 服務，不付 worker 額外開銷。
    "run_worker_first": ["/", "/sitemap-courses.xml", "/api/*"]
  },
  "vars": {
    "DATA_BASE_URL": "https://cdn.ntutbox.com/course/v1"
  },
  // /api/model-token 每 IP 每分鐘上限（token 效期 10 分鐘，正常使用一分鐘不到 1 次）。
  // MODEL_TOKEN_SECRET 是 secret（wrangler secret put），不放這裡。
  "ratelimits": [
    { "name": "MODEL_TOKEN_LIMITER", "namespace_id": "3802", "simple": { "limit": 30, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
