# --- secrets / 個資 (公開 repo 嚴禁) ---
.env
.env.*
*.local
secrets/
*.key

# --- Node / Next.js ---
node_modules/
.next/
out/
dist/
build/
.turbo/
*.tsbuildinfo
.vercel/
coverage/

# --- Python (crawler) ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- 爬蟲產生物：main 完全不放 data（canonical 在 orphan `data` branch，v1 為 R2 衍生物）---
crawler/dist/
crawler/.scratch/
data/
# Allow web src/public directories named "data" (lib/data, public/data fixtures, etc.)
!apps/web/src/**/data/
!apps/web/src/**/data/**
!apps/web/public/data/
!apps/web/public/data/**
# ...but NOT the per-course detail fixtures: 2400+ files, bulky; prod fetches them
# lazily from the CDN. Built/copied locally for dev only.
apps/web/public/data/v1/terms/*/course/
*.sqlite
*.sqlite-*

# --- Cloudflare Workers 建置產物 ---
# wrangler dev/deploy 會在此產生 bundle-*/dev-* 暫存檔（middleware facade、source map）。
# 曾被誤commit進版控，是 4 個長期 eslint no-unused-vars warning 的來源（#72）。
.wrangler/

# packages/schema 的 `pnpm generate` 走 `pnpm dlx json-schema-to-typescript`，
# 會在該目錄留下一份無用的 lockfile 副作用；apps/web/pnpm-lock.yaml 是正式的、不在此列。
packages/schema/pnpm-lock.yaml

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# Superpowers brainstorm visual companion (local mockups)
.superpowers/
