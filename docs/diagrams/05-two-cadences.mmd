flowchart TB
    worker["Cloudflare Worker ntutbox-season-scheduler<br/>cron 每小時整點<br/>讀 course/ops/season-schedule.json"]

    subgraph DAILY["daily.yml · 每日 04:00"]
        d1["calendar · catalog + 人數 · mprograms<br/>(active = 本學期 ∪ 30 天內有選課窗口的學期)"]
    end
    subgraph WEEKLY["weekly.yml · 每週一 05:30"]
        w1["details · standards"]
    end
    subgraph SEASON["season.yml · Worker 依排程觸發"]
        s1["enrollment: 只讀人/撤<br/>全校一次查 · 快照 + 觀測紀錄<br/>(亦可手動 dispatch，terms 必填)"]
    end
    subgraph MAINT["maintenance.yml · 僅 dispatch"]
        m1["backfill: 任何資料集 + 學期<br/>republish: derive + publish"]
    end

    worker -->|"命中觸發格 → workflow_dispatch (terms)"| s1
    worker -.->|"每週一 00:00 保活<br/>enable daily / weekly"| d1
    worker -.->|保活| w1

    d1 --> L["commit-publish<br/>(concurrency: data-pipeline)<br/>merge → derive → commit → publish"]
    w1 --> L
    s1 --> L
    m1 --> L
    L --> R2["R2 / cdn.ntutbox.com"]
    L --> AL["alert: pipeline-alert issue"]
    R2 --> web["Web / App"]
    R2 -.->|"season-schedule.json (derive 產出)"| worker

    classDef daily fill:#bfdbfe,stroke:#1e40af,color:#000
    classDef fast fill:#fde68a,stroke:#b45309,color:#000
    classDef out fill:#bbf7d0,stroke:#15803d,color:#000
    classDef trig fill:#e9d5ff,stroke:#7e22ce,color:#000
    class d1,w1 daily
    class s1,m1 fast
    class R2,web out
    class worker trig
