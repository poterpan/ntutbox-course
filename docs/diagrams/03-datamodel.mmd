flowchart LR
    subgraph C["canonical (git data branch · 真相 · 內容不帶時間)"]
        cat["catalog.ndjson<br/>純結構"]
        cls["classes.json<br/>班級 + kind"]
        snap["enrollment/YYYY-MM-DDTHHMM.ndjson<br/>人數快照 (有變才寫)"]
        obs["enrollment/observations.ndjson<br/>每次觀測一行"]
        det["details.ndjson<br/>課綱原文"]
        fs["_meta/fetch-state.json<br/>checked_at / changed_at / sha"]
    end

    subgraph V["v1 (R2 · derive 重建)"]
        vcat["catalog.json"]
        vcls["classes.json"]
        vper["periods.json"]
        venr["enrollment.json<br/>最新 overlay"]
        vcourse["course/{id}.json<br/>+ 逐週進度 (即時算)"]
        man["manifest.json<br/>checked_at / changed_at / count"]
    end

    web["Web / App:<br/>結構 catalog (快取久)<br/>+ 人數 overlay (快取短)"]

    cat --> vcat
    cls --> vcls
    snap -->|latest| venr
    obs -->|observed_at| venr
    det --> vcourse
    fs --> man
    vcat --> man
    venr --> man
    vcat -.-> web
    venr -.-> web

    classDef canon fill:#fde68a,stroke:#b45309,color:#000
    classDef v1c fill:#bfdbfe,stroke:#1e40af,color:#000
    class cat,cls,snap,obs,det,fs canon
    class vcat,vcls,vper,venr,vcourse,man v1c
