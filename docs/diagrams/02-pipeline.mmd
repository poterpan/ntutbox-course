---
config:
  flowchart:
    useMaxWidth: false
    wrappingWidth: 480
    nodeSpacing: 30
    rankSpacing: 40
---
flowchart TB
    subgraph S1["① fetch job (不上鎖)"]
        direction LR
        A["cron / Worker 觸發 season<br/>/ 手動 dispatch"] --> B["pipeline --cadence X<br/>每個 (資料集, 學期) 獨立 try"] --> B2["stage + pipeline-result.json<br/>(含 current_term)"]
    end

    subgraph S2["② commit-publish job · merge (concurrency: data-pipeline)"]
        direction LR
        D["checkout 最新<br/>data branch"] --> E["merge<br/>只收成功者 · 快照去重<br/>觀測追加 · 節點失敗規則"] --> Q{{"課數 / 人數快照列數<br/>對 HEAD 檢查"}}
        Q -->|"0 課 / 0 列<br/>或當前學期 < HEAD×0.95"| QX["丟棄該學期<br/>沿用 HEAD"]
        Q -->|"驟減 · 非當前學期"| QW["照收 + warning"]
    end

    subgraph S3["③ 紅線掃描 → derive → commit"]
        direction LR
        H{{"紅線掃描"}} -->|命中個資 / 機密| HX["✗ 中止"]
        H -->|乾淨| I["pua-scan → derive<br/>v1 + reports<br/>+ ops/season-schedule.json"] --> MR["逐時段教室 (D24)<br/>rooms.json 反查<br/>→ v1 meetings[].classroom_codes<br/>+ reports/{t}/meeting-rooms.json"] --> J["commit + push<br/>data branch"]
    end

    subgraph S4["④ publish"]
        direction LR
        K{{"quality gate<br/>對線上 manifest count"}} -->|"當前學期驟降<br/>/ 任一學期 0 課"| KX["✗ 不發佈 (exit 1)"]
        K -->|"通過 (非當前學期<br/>驟降 → ::warning)"| L["全量 MD5 比對 → 只傳差異<br/>manifest 最後 → 過期刪除<br/>(10% 保險，觸發 exit 3)"] --> M["R2 / cdn.ntutbox.com"]
    end

    subgraph S5["⑤ 發佈後"]
        direction LR
        W{{"預設學期的 catalog 有變？<br/>(infra/web_redeploy.py)"}} -->|是| WH["POST Deploy Hook<br/>→ 重建 web<br/>(失敗只 warning)"]
        W -->|"否 / secret 未設"| WS["略過"]
        DC["daily 限定檢查<br/>行事曆 horizon／coverage · 資料過期<br/>season 缺 catalog · season 未依排程"]
        GD["weekly：GIS updateSequence<br/>只寫 run summary、不開 issue"]
        WS ~~~ DC
        WS ~~~ GD
    end

    AL["alert job → pipeline-alert issue · 紅框＝失敗 · 黃框＝warning<br/>逐時段教室 conflict > 0 且報告有變才 warning"]

    S1 --> S2
    S2 --> S3
    S3 --> S4
    S4 --> S5
    S5 -.-> AL

    classDef bad fill:#fecaca,stroke:#b91c1c,color:#000
    classDef warn fill:#fde68a,stroke:#b45309,color:#000
    classDef ok fill:#bbf7d0,stroke:#15803d,color:#000
    classDef store fill:#bfdbfe,stroke:#1e40af,color:#000
    classDef trig fill:#e9d5ff,stroke:#7e22ce,color:#000
    classDef muted fill:#f3f4f6,stroke:#4b5563,color:#000
    class HX,QX,KX bad
    class QW,MR warn
    class M ok
    class WH trig
    class GD muted
    class AL bad
